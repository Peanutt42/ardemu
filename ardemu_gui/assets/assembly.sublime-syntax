%YAML 1.2
---
name: AVR Assembly
file_extensions:
  - asm
  - S
  - inc
scope: source.avrasm

contexts:
  main:
    # Keywords (AVR instructions)
    - match: (?i)\b(nop|break|jmp|or|ori|eor|com|neg|swap|lsr|ror|asr|mul|ldi|mov|movw|rjmp|push|pop|cp|cpi|cpc|cpse|breq|brne|brlt|brcs|brcc|call|ret|rcall|sub|sbc|subi|sbci|sbiw|dec|add|adc|adiw|inc|and|andi|bset|bclr|sei|cli|sbi|cbi|bst|bld|sts|lds|ld|st|out|in|lpm)\b
      scope: keyword.control.avr

    # Registers (R0-R31, X/Y/Z pointers)
    - match: (?i)\b(r[0-3]?[0-9]|x|y|z)\b
      scope: variable.language.register.avr

    # Preprocessor directives
    - match: (?i)^\s*\.[a-z]+
      scope: keyword.other.directive.avr
      push:
        - meta_scope: meta.preprocessor.avr
        - match: $
          pop: true

    # Numbers (hex, binary, decimal)
    - match: (?i)\b(0x[0-9a-f]+|0b[01]+|\d+)\b
      scope: constant.numeric.avr

    # Labels
    - match: \b[a-zA-Z_]\w*\b
      scope: entity.name.function.label.avr

    # Comments
    - match: ";.*$"
      scope: comment.line.semicolon.avr

    # Strings
    - match: '"'
      scope: punctuation.definition.string.begin.avr
      push: string_content

  string_content:
    - meta_scope: string.quoted.double.avr
    - match: '"'
      scope: punctuation.definition.string.end.avr
      pop: true
    - match: '\\.'
      scope: constant.character.escape.avr